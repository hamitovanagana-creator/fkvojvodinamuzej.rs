Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force non-www. Checked first (independent of scheme) so a www + http
  # visitor lands on https+non-www in a single redirect instead of two hops.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Force HTTPS. Checks X-Forwarded-Proto (set by Cloudflare) in addition to
  # %{HTTPS}, since Cloudflare may proxy to the origin over plain HTTP even
  # when the visitor connected over HTTPS - relying on %{HTTPS} alone would
  # either miss real HTTP visitors or create a redirect loop.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Affiliate redirect - kept out of page HTML so the raw affiliate URL
  # never appears in static content (avoids host-side malware-scanner
  # false positives that were quarantining pages containing it directly)
  RewriteRule ^promo/?$ https://affrs.top/L?tag=e_5913660m_96329c_&site=5913660&ad=96329&r=slots [R=301,L,NC]

  # Google/Bing verification files - serve directly, no redirect
  RewriteCond %{REQUEST_URI} ^/(google|BingSiteAuth)[a-zA-Z0-9]*\.(html|xml)$ [NC]
  RewriteRule ^ - [L]

  # sitemap.xml → serve via sitemap.php (dynamic lastmod date)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # .html → redirect to trailing-slash URL
  RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # Add trailing slash if missing (not a real file or directory)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # Internally serve slug/ as slug.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/$ $1.html [L]

  # Internally serve slotovi/slug/ as slotovi/slug.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^slotovi/([^/]+)/$ slotovi/$1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
